{
  "compilerOptions": {
    "target": "es2022",                          /* Output modern JavaScript */
    "module": "es2022",                        /* Enforce modern Node.js import behaviors */
    "moduleResolution": "bundler",              /* Enable the importation of es modules */
    "rootDir": "./src",                          /* Where your TypeScript source files live */
    "outDir": "./dist",                          /* Where the translated JavaScript files will be built */
    "strict": true,                              /* Turn on strict type checking for max safety */
    "esModuleInterop": true,                     /* Allows seamless importing of CommonJS packages */
    "skipLibCheck": true,                        /* Speeds up compilation by skipping checking external library files */
    "forceConsistentCasingInFileNames": true     /* Disallow file path casing typos */
  },
  "include": ["src/**/*"]                        /* Tells the compiler to look inside your src folder */
}
